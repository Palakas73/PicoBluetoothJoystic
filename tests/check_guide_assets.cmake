foreach(file README.TXT MANUAL.HTM AUTOFIRE.PNG VERSION.TXT)
  if(NOT EXISTS "${ROOT}/assets/guide/${file}")
    message(FATAL_ERROR "Missing guide asset: ${file}")
  endif()
endforeach()
file(READ "${ROOT}/assets/guide/README.TXT" readme)
file(READ "${ROOT}/assets/guide/MANUAL.HTM" manual)
file(READ "${ROOT}/assets/guide/VERSION.TXT" version)
foreach(text "5 presses/second" "20 presses/second" "RAM" "BOOTSEL" "PICO_GUIDE")
  string(FIND "${readme}" "${text}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "README missing: ${text}")
  endif()
endforeach()
foreach(text "AUTOFIRE.PNG" "View + Menu" "Minus + Plus" "Read-only" "Bluetooth connection limits" "Goal of this stage" "single Classic HID connection" "Remembered Bluetooth Classic identities" "BOND PAIR" "BOND REMOVE" "INPUT_READY" "temporary key slot")
  string(FIND "${manual}" "${text}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "MANUAL missing: ${text}")
  endif()
endforeach()
string(FIND "${version}" "dual-xinput-autofire-msc-ds4-stage1" found)
if(found EQUAL -1)
  message(FATAL_ERROR "VERSION capability ID missing")
endif()
string(FIND "${manual}" "Experimental Nintendo Switch Pro Controller" found)
if(found EQUAL -1)
  message(FATAL_ERROR "Switch Pro experimental status missing from manual")
endif()
string(FIND "${manual}" "Experimental DualShock 4" found)
if(found EQUAL -1)
  message(FATAL_ERROR "DS4 experimental status missing from manual")
endif()
file(SIZE "${ROOT}/assets/guide/AUTOFIRE.PNG" png_size)
file(READ "${ROOT}/assets/guide/AUTOFIRE.PNG" png_dimensions OFFSET 16 LIMIT 8 HEX)
string(SUBSTRING "${png_dimensions}" 0 8 png_width_hex)
string(SUBSTRING "${png_dimensions}" 8 8 png_height_hex)
math(EXPR png_width "0x${png_width_hex}")
math(EXPR png_height "0x${png_height_hex}")
if(png_size GREATER 700000 OR png_width LESS 900 OR png_height LESS 450)
  message(FATAL_ERROR "AUTOFIRE.PNG outside flash/readability budget: ${png_size} bytes, ${png_width}x${png_height}")
endif()
